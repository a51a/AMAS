# AMAS local configuration. Copy to .env and adjust. Never commit .env.

# Where the SQLite database, recordings, frames and exports live (git-ignored).
AMAS_DATA_DIR=./data

# Web server
AMAS_HOST=127.0.0.1
AMAS_PORT=8000

# Frame extraction / segmentation defaults
AMAS_FRAME_FPS=1.0
AMAS_FRAME_WIDTH=480
# Fraction of the frame width (centered) used for transition detection.
# Desktop web Reels show the video in a centered column; 0.4 ignores side UI.
AMAS_SEGMENT_CROP_WIDTH=0.4
AMAS_SEGMENT_MIN_SECONDS=3.0
AMAS_SEGMENT_DIFF_THRESHOLD=28.0

# Classification
# mock = keyword classifier, no network, no API key (default)
# anthropic = vision LLM via the Anthropic API (requires explicit per-experiment consent)
AMAS_CLASSIFIER=mock
AMAS_REVIEW_CONFIDENCE_THRESHOLD=0.7
# Hard kill switch: external providers are refused unless this is true.
AMAS_ALLOW_EXTERNAL_PROVIDERS=false
ANTHROPIC_API_KEY=
AMAS_ANTHROPIC_MODEL=claude-opus-5-5
AMAS_LLM_MAX_FRAMES_PER_REEL=3

# Optional local OCR for captions/hashtags (uses `tesseract` binary if installed). auto|off
AMAS_OCR=auto
